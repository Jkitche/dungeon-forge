{
  "name": "dungeon-forge",
  "productName": "Dungeon Forge",
  "version": "1.0.0",
  "description": "Randomly generated D&D dungeon maps with export to Roll20, Foundry VTT, Universal VTT (.dd2vtt) and more.",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=98 --test-coverage-branches=93 --test-coverage-functions=98 \"test/**/*.test.ts\"",
    "sentry:sourcemaps": "node scripts/sourcemaps.ts",
    "dist": "npm run build && npm run sentry:sourcemaps && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "dnd",
    "dungeon",
    "generator",
    "roll20",
    "foundry",
    "vtt",
    "electron"
  ],
  "author": "Jae Kitchens",
  "license": "MIT",
  "devDependencies": {
    "@sentry/cli": "3.8.2",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@sentry/electron": "8.3.0"
  },
  "build": {
    "appId": "io.github.jkitche.dungeonforge",
    "productName": "Dungeon Forge",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/.reload",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.role-playing-games"
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "allowScripts": {
    "@sentry/cli": false,
    "electron-winstaller": false
  }
}
