{
  "name": "dungeon-forge",
  "productName": "Dungeon Forge",
  "version": "1.0.0",
  "description": "Randomly generated D&D dungeon maps with export to Roll20, Foundry VTT, Universal VTT (.dd2vtt) and more.",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=98 --test-coverage-branches=93 --test-coverage-functions=98 \"test/**/*.test.ts\""
  },
  "keywords": [
    "dnd",
    "dungeon",
    "generator",
    "roll20",
    "foundry",
    "vtt",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "typescript": "^7.0.2"
  }
}
